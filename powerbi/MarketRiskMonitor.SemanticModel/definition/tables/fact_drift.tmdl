	partition fact_drift = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(DataFolder & "\fact_drift.parquet")),
				    Typed = Table.TransformColumnTypes(Source, {{"run_id", type text}, {"measured_at", type datetime}, {"feature", type text}, {"psi", type number}, {"status", type text}, {"window_start", type date}, {"window_end", type date}})
				in
				    Typed

	annotation PBI_ResultType = Table
