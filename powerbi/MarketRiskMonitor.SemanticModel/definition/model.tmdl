model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-GB
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 0

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["dim_date","dim_instrument","dim_source","dim_position","fact_market","fact_correlation","fact_pnl","fact_dq","fact_dq_flags","fact_freshness","DataFolder"]

ref table dim_date
ref table dim_instrument
ref table dim_source
ref table dim_position
ref table fact_market
ref table fact_correlation
ref table fact_pnl
ref table fact_dq
ref table fact_dq_flags
ref table fact_freshness
ref table _Measures

ref cultureInfo en-GB
