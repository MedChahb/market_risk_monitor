# Secrets
.env

# Raw market data: vendor terms, kept out of Git (only derived tables in data/gold/)
data/raw/

# Python
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/

# MLflow tracking database and model registry, local runs
mlruns/
data/mlflow.db

# Model forecasts (loaded to the gold tables by publish)
data/forecasts/

# Data quality results (loaded to the gold tables in Step 4)
data/dq/

# Run history, drift and promotion decisions (loaded to the gold tables by publish)
data/monitoring/

# Power BI binaries: attached to GitHub releases, never committed (the PBIP project is the source)
*.pbix

# Power BI Desktop local state (per user and machine)
**/.pbi/localSettings.json
**/.pbi/cache.abf

# Power BI Desktop TMDL view scratch scripts
**/TMDLScripts/
